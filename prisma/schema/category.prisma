model Category {
  id          String     @id @default(uuid())
  name        String     @unique @db.VarChar(100)
  slug        String     @unique @db.VarChar(120)
  description String?

  gearItems   GearItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}