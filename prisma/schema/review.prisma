model Review {
  id         String @id @default(uuid())
  customerId String
  gearId     String
  rentalId   String @unique

  rating  Int
  comment String?

  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  gear     GearItem @relation(fields: [gearId], references: [id], onDelete: Restrict)
  rental   Rental   @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([gearId])
  @@map("reviews")
}